# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated data. Pipelines write here; output is reproducible from a seed,
# so it never belongs in git. Scoped to output directories on purpose: a
# blanket *.csv would silently swallow a future test fixture.
output/
out/

# Internal working notes. The brainstorm transcripts name internal projects,
# local paths, and collaborators, so they stay out of the public repo. The
# decisions that matter are restated in docs/specs/.
docs/brainstorms/

# Claude Code. CLAUDE.md and .claude/settings.json are shared instructions and
# belong in the repo, exactly like CONTRIBUTING.md. Only per-developer local
# overrides are ignored.
.claude/settings.local.json
CLAUDE.local.md

# Browser automation scratch output
.playwright-mcp/

# Editors and OS
.DS_Store
.idea/
.vscode/
