# What this repo publishes is the package and its tests. Everything else is
# real work that stays on this machine: issue logs, specs, brainstorms, session
# handoffs, the worked examples, the dev tooling, and the agent instructions.
# The front end lives in its own repo, github.com/emmanuelwunjc/synthweave-frontend.
docs/
examples/
tools/
demo/
CLAUDE.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/

# Secrets. Never committed, read at runtime by src/synthweave/connectors/.
.env
.env.local

# Cached connector responses (e.g. ACS PUMS), regenerable from the API.
.synthweave_cache/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated data. Pipelines write here; output is reproducible from a seed,
# so it never belongs in git. Scoped to output directories on purpose: a
# blanket *.csv would silently swallow a future test fixture.
output/
out/

# Claude Code local overrides. CLAUDE.md itself is ignored above, since the
# instructions in it are for this machine rather than for the world.
.claude/settings.local.json
CLAUDE.local.md

# Browser automation scratch output
.playwright-mcp/

# Editors and OS
.DS_Store
.idea/
.vscode/
